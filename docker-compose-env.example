# Local-only Compose settings. Copy to docker-compose-env.env to change ports.
# The defaults in docker-compose.yml are for disposable local data.
LV_ENV=local
LV_LOG_LEVEL=info

LV_FRONTEND_PORT=3000
LV_BACKEND_PORT=8080
LV_AGENT_PORT=8090
LV_PG_PORT=5432
LV_REDIS_PORT=6379
LV_KAFKA_PORT=9092
LV_MINIO_PORT=9000
LV_MINIO_CONSOLE_PORT=9001
LV_TEMPORAL_PORT=7233
LV_TEMPORAL_UI_PORT=8233
LV_KAFKA_UI_PORT=8088

# Replace these local development defaults before exposing services.
LV_PG_PASSWORD=lanverse-local
LV_MINIO_PASSWORD=lanverse-local
