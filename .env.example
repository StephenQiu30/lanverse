# Lanverse development 环境变量模板
# 使用方式：在仓库根目录执行 `cp .env.example .env`，只修改生成的 `.env`。
# 安全边界：`.env` 不得提交；所有 `NEXT_PUBLIC_*` 都会暴露给浏览器，禁止放入密钥。
# 本模板提供的密码仅用于本地开发，生产环境必须通过部署平台注入独立强密码。

# -----------------------------------------------------------------------------
# 应用与 API（FastAPI Settings；Compose 只覆盖容器内部监听地址）
# -----------------------------------------------------------------------------
# 应用展示名；会写入 OpenAPI 元数据。
APP_NAME=Lanverse API
# 运行环境：development、test 或 production。
ENVIRONMENT=development
# Python 日志级别，例如 DEBUG、INFO、WARNING、ERROR。
LOG_LEVEL=INFO
# API 监听地址与端口；本机开发由 app.server 读取。
API_HOST=0.0.0.0
API_PORT=8686
# 浏览器跨域白名单，必须是 JSON 字符串数组，不支持逗号分隔字符串。
CORS_ORIGINS=["http://localhost:8123","http://127.0.0.1:8123"]

# -----------------------------------------------------------------------------
# 本机基础设施连接（本机 API、Scheduler 和 Worker 使用）
# -----------------------------------------------------------------------------
# SQLAlchemy 异步连接串；驱动必须为 postgresql+asyncpg。
DATABASE_URL=postgresql+asyncpg://postgres:lanverse-development-only@127.0.0.1:5432/lanverse
# 测试专用数据库；必须显式配置、以 _test 结尾，且不能与 DATABASE_URL 相同。
TEST_DATABASE_URL=postgresql+asyncpg://postgres:lanverse-development-only@127.0.0.1:5432/lanverse_test
# Redis 当前用于可降级缓存；数据库编号保留为 0。
REDIS_URL=redis://127.0.0.1:6379/0
# Workspace 详情投影的基础 TTL 秒数，允许 1-3600。
WORKSPACE_CACHE_TTL_SECONDS=60
# TTL 随机抖动上限秒数，必须小于 Workspace TTL。
CACHE_TTL_JITTER_SECONDS=10
# 高成本生成固定窗口秒数；Redis 不可用时此类提交会 fail closed。
GENERATION_HIGH_COST_WINDOW_SECONDS=60
# 单 Workspace 在一个窗口内允许的新高成本生成数。
GENERATION_HIGH_COST_WORKSPACE_LIMIT=3
# 全局在一个窗口内允许的新高成本生成数，不能低于 Workspace 上限。
GENERATION_HIGH_COST_GLOBAL_LIMIT=20
# 请求摘要去抖 TTL，必须不短于限流窗口；PostgreSQL 仍是最终幂等事实。
GENERATION_HIGH_COST_IDEMPOTENCY_TTL_SECONDS=900
# RabbitMQ 用于 Outbox 事件投递和 Worker 消费。
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
# 单次领取的 Outbox 事件数，允许 1-100。
OUTBOX_BATCH_SIZE=20
# 事件领取租约秒数，允许 5-3600；超过后可被重新领取。
OUTBOX_CLAIM_SECONDS=60
# 无可投递事件时的轮询间隔秒数，允许 0.1-60。
OUTBOX_POLL_SECONDS=1.0

# -----------------------------------------------------------------------------
# MinIO 对象存储（本机复用 Homebrew 服务；完整 Compose 使用 minio/minio:latest）
# -----------------------------------------------------------------------------
# S3 endpoint 只填写 host:port，不带 http:// 或 https://；本机 Homebrew MinIO 使用 9000。
MINIO_ENDPOINT=127.0.0.1:9000
# 应用访问凭据；本地值必须与本机 MinIO 一致，完整 Compose 用同一组值初始化容器。
MINIO_ACCESS_KEY=lanverse
MINIO_SECRET_KEY=lanverse-development-only
# 媒体对象桶；应用会按既定流程检查或创建。
MINIO_BUCKET=lanverse-media
# 本地 HTTP 为 false；仅当 endpoint 实际启用 TLS 时设为 true。
MINIO_SECURE=false
# PostgreSQL、Redis、RabbitMQ、MinIO 的快速探测超时秒数，范围 (0, 10]。
INFRASTRUCTURE_TIMEOUT_SECONDS=1.5
# 同步 MinIO SDK 的并发线程上限，允许 1-32。
STORAGE_THREAD_LIMIT=4
# 每次 MinIO SDK 操作超时秒数，允许 0.1-30；超时映射为稳定依赖错误。
STORAGE_OPERATION_TIMEOUT_SECONDS=3

# -----------------------------------------------------------------------------
# 媒体处理限制（API、I/O Worker、Media Worker 共用）
# -----------------------------------------------------------------------------
# 单文件最大上传字节数；默认 2 GiB。
MEDIA_MAX_UPLOAD_BYTES=2147483648
# 上传预签名 URL 有效期秒数，允许 60-3600。
MEDIA_UPLOAD_TTL_SECONDS=900
# 下载/预览预签名 URL 有效期秒数，允许 30-900。
MEDIA_ACCESS_TTL_SECONDS=300
# ffprobe 媒体探测超时秒数，允许 5-600。
MEDIA_PROBE_TIMEOUT_SECONDS=120
# Workspace 过期临时上传补偿清理周期秒数，允许 60-86400。
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
# 每次补偿任务最多锁定并清理的 UploadSession 数，允许 1-500。
MEDIA_CLEANUP_BATCH_SIZE=100
# 位置迁移后保留旧对象的回滚窗口秒数，允许 60-604800（7 天）。
MEDIA_LOCATION_ROLLBACK_SECONDS=86400

# -----------------------------------------------------------------------------
# API 身份认证（仅后端使用，禁止增加 NEXT_PUBLIC_ 前缀）
# -----------------------------------------------------------------------------
# 本地开发占位密钥；生产环境必须替换为至少 32 个随机字节的独立密钥。
JWT_SECRET_KEY=development-only-jwt-secret-change-before-production
# JWT 的签发方、受众和访问令牌有效期（分钟，允许 5-1440）。
JWT_ISSUER=lanverse-api
JWT_AUDIENCE=lanverse-web
JWT_ACCESS_TOKEN_MINUTES=30
AUTH_SESSION_TTL_SECONDS=2592000

# -----------------------------------------------------------------------------
# 注册邮箱验证（仅后端使用；真实凭据不得提交）
# -----------------------------------------------------------------------------
# 本地未配置 SMTP 时注册发信明确不可用；可从既有 HotKey 本地配置安全映射。
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lanverse
SMTP_TIMEOUT_SECONDS=10
# 必须与 JWT 密钥不同；生产环境使用至少 32 个随机字节的独立密钥。
EMAIL_VERIFICATION_HMAC_SECRET=development-only-registration-hmac-change-before-production
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TICKET_TTL_SECONDS=600
# 单一客户端来源的短窗口发送上限；邮箱仍有独立重发冷却。
EMAIL_VERIFICATION_SOURCE_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_SOURCE_LIMIT=20

# -----------------------------------------------------------------------------
# AI Provider（可选；未配置时相关能力明确不可用，不使用模拟结果兜底）
# -----------------------------------------------------------------------------
# DeepSeek 官方 API 密钥。默认留空；模型、Base URL 和推理参数由受审查代码固定。
DEEPSEEK_API_KEY=
# 剧本结构解析 provider：codex_local（默认）、deepseek 或 disabled。
SCRIPT_EXTRACTION_PROVIDER=codex_local
# 可选的本机 Codex 可执行文件路径；留空时使用本机 Codex SDK 运行时。
CODEX_CLI_PATH=
# 可选的本机 Codex 模型；留空时使用 Codex 本机默认模型。
CODEX_MODEL=
# 本地 Codex 并行分块数，默认 2，避免压垮 app-server 队列。
CODEX_MAX_CONCURRENCY=2
# 火山方舟 API Key 占位。当前未接入 Ark SDK，保持为空即表示能力不可用。
ARK_API_KEY=
# Provider 凭据加密 key ID；轮换时必须更换并保留旧密钥直到迁移完成。
PROVIDER_CREDENTIAL_KEY_ID=local-provider-v1
# 两项均为独立 32-byte 随机值的 URL-safe Base64；默认留空时凭据操作 fail closed。
PROVIDER_CREDENTIAL_MASTER_KEY=
PROVIDER_CREDENTIAL_FINGERPRINT_KEY=

# -----------------------------------------------------------------------------
# 前端与代码生成
# -----------------------------------------------------------------------------
# 浏览器可见的 API 地址；会在 Next.js 构建时写入客户端包，严禁包含 secret。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8686
# 仅供 npm run openapi2ts 拉取 FastAPI schema，不会注入浏览器。
OPENAPI_SCHEMA_URL=http://127.0.0.1:8686/openapi.json

# -----------------------------------------------------------------------------
# Docker Compose development 快速启动
# -----------------------------------------------------------------------------
# 应用镜像名；docker-dev-up 会在启动前构建同名镜像。生产镜像在 .env.production 中单独配置。
BACKEND_IMAGE=lanverse-backend:latest
FRONTEND_IMAGE=lanverse-frontend:latest
# Web 与基础设施发布到宿主机的端口；应用容器内外统一使用固定端口。
# 以下 MinIO 端口只用于 Compose 发布到宿主机，避开本机 Homebrew MinIO 的 9000/9001。
WEB_PORT=8123
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
MINIO_API_PORT=9100
MINIO_CONSOLE_PORT=9101
# PostgreSQL 与 RabbitMQ 初始化配置；密码使用未提交的环境文件覆盖。
POSTGRES_DB=lanverse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lanverse-development-only
RABBITMQ_DEFAULT_USER=lanverse
RABBITMQ_DEFAULT_PASS=lanverse-development-only
