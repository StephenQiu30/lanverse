# Local processes read the root .env. This template contains example values only.
# Copy it only if .env does not already exist; keep real credentials untracked.
LV_ENV=local
LV_LOG_LEVEL=info
LV_HTTP_ADDR=:8080
PORT=3000

# API startup requires a reachable business database. Replace the placeholder
# credentials with access to the PostgreSQL service already running on this host.
LV_DB_DSN=postgres://lanverse:replace-me@127.0.0.1:5432/lanverse?sslmode=disable

# The following connections will be consumed as their modules are implemented.
# Point them at services already running on this host.
LV_REDIS_URL=redis://127.0.0.1:6379/0
LV_KAFKA_BROKERS=127.0.0.1:9092
LV_TEMPORAL_ADDR=127.0.0.1:7233
LV_TEMPORAL_NAMESPACE=lanverse-local
LV_S3_ENDPOINT=http://127.0.0.1:9000
LV_S3_BUCKET=lanverse-local
LV_S3_ACCESS_KEY=replace-me
LV_S3_SECRET_KEY=replace-me
