# Lanverse 本机开发环境变量模板
# 复制为 .env 后按本机服务填写；真实 .env 不得提交。

APP_NAME=Lanverse API
ENVIRONMENT=development
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8686
CORS_ORIGINS=["http://localhost:8123","http://127.0.0.1:8123"]

DATABASE_URL=postgresql+asyncpg://postgres:lanverse-development-only@127.0.0.1:5432/lanverse
TEST_DATABASE_URL=postgresql+asyncpg://postgres:lanverse-development-only@127.0.0.1:5432/lanverse_test
REDIS_URL=redis://127.0.0.1:6379/0
WORKSPACE_CACHE_TTL_SECONDS=60
CACHE_TTL_JITTER_SECONDS=10
GENERATION_HIGH_COST_WINDOW_SECONDS=60
GENERATION_HIGH_COST_WORKSPACE_LIMIT=3
GENERATION_HIGH_COST_GLOBAL_LIMIT=20
GENERATION_HIGH_COST_IDEMPOTENCY_TTL_SECONDS=900
RABBITMQ_URL=amqp://guest:guest@127.0.0.1:5672/
OUTBOX_BATCH_SIZE=20
OUTBOX_CLAIM_SECONDS=60
OUTBOX_POLL_SECONDS=1.0

MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=lanverse
MINIO_SECRET_KEY=lanverse-development-only
MINIO_BUCKET=lanverse-media
MINIO_SECURE=false
INFRASTRUCTURE_TIMEOUT_SECONDS=1.5
STORAGE_THREAD_LIMIT=4
STORAGE_OPERATION_TIMEOUT_SECONDS=3
MEDIA_MAX_UPLOAD_BYTES=2147483648
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_ACCESS_TTL_SECONDS=300
MEDIA_PROBE_TIMEOUT_SECONDS=120
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CLEANUP_BATCH_SIZE=100
MEDIA_LOCATION_ROLLBACK_SECONDS=86400

JWT_SECRET_KEY=development-only-jwt-secret-change-before-production
JWT_ISSUER=lanverse-api
JWT_AUDIENCE=lanverse-web
JWT_ACCESS_TOKEN_MINUTES=30
AUTH_SESSION_TTL_SECONDS=2592000
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lanverse
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_HMAC_SECRET=development-only-registration-hmac-change-before-production
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TICKET_TTL_SECONDS=600
EMAIL_VERIFICATION_SOURCE_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_SOURCE_LIMIT=20

SCRIPT_EXTRACTION_PROVIDER=codex_local
CODEX_CLI_PATH=
CODEX_MODEL=
CODEX_MAX_CONCURRENCY=2
DEEPSEEK_API_KEY=
ARK_API_KEY=
PROVIDER_CREDENTIAL_KEY_ID=local-provider-v1
PROVIDER_CREDENTIAL_MASTER_KEY=
PROVIDER_CREDENTIAL_FINGERPRINT_KEY=

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8686
OPENAPI_SCHEMA_URL=http://127.0.0.1:8686/openapi.json
