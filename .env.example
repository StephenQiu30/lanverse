# Local processes read the root .env. This template contains example values only.
# Copy it only if .env does not already exist; keep real credentials untracked.
LV_ENV=local
LV_LOG_LEVEL=info
LV_HTTP_ADDR=127.0.0.1:8080
# Browser Origin and the Next.js internal API rewrite are separate addresses.
LV_PUBLIC_ORIGIN=http://127.0.0.1:3000
LV_API_BASE_URL=http://127.0.0.1:8080
LV_WORKER_HEALTH_ADDR=:8081
LV_RELAY_HEALTH_ADDR=:8082
# Host port mappings used only by the later application Compose deployment.
LV_WORKER_HEALTH_PORT=8081
LV_MEDIA_WORKER_HEALTH_PORT=8083
LV_RELAY_HEALTH_PORT=8082
PORT=3000

# Backend roles require a reachable business database and their service configuration.
# Replace the database placeholder with access to the service already running here.
LV_DB_DSN=postgres://lanverse:replace-me@127.0.0.1:5432/lanverse?sslmode=disable
# Only `lanverse partitions ensure` uses this separate owner account on the same database.
LV_PARTITION_MAINTENANCE_DB_DSN=postgres://lanverse_owner:replace-me@127.0.0.1:5432/lanverse?sslmode=disable
LV_REDIS_URL=redis://127.0.0.1:6379/0
LV_TEMPORAL_ADDR=127.0.0.1:7233
LV_TEMPORAL_NAMESPACE=lanverse-local

# The relay publishes Outbox rows and consumes supported realtime events through this broker.
LV_KAFKA_BROKERS=127.0.0.1:9092

# The object storage bucket must already exist and be accessible with these credentials.
# Point the endpoint at the S3-compatible service already running on this host.
LV_OBJECT_STORAGE_ENDPOINT=http://127.0.0.1:9000
LV_OBJECT_STORAGE_BUCKET=lanverse-local
LV_OBJECT_STORAGE_ACCESS_KEY=replace-me
LV_OBJECT_STORAGE_SECRET_KEY=replace-me
LV_OBJECT_STORAGE_REGION=us-east-1

# Generated-result downloads require exact HTTPS provider origins. A local TLS
# fixture may opt into loopback only in LV_ENV=local; keep it off for real media.
LV_MEDIA_RESULT_ALLOWED_ORIGINS=
LV_MEDIA_ALLOW_TEST_LOOPBACK_TLS=false
# 可选本机 whisper.cpp 根地址。留空时新字幕任务明确不可用；不含 /inference。
LV_WHISPER_ENDPOINT=

# Optional RSA credentials configuration. API seals with a public-key file;
# Agent tests credentials with its private-key file. Supply a shared key ID.
LV_CREDENTIAL_KEY_ID=
LV_CREDENTIAL_PUBLIC_KEY_FILE=
LV_CREDENTIAL_PRIVATE_KEY_REF=

# Optional OTLP/HTTP collector origin. Leave empty when no host collector is running.
LV_OTEL_ENDPOINT=
