# 本地应用连接配置。复制为 .env，填写本机已有服务；不会创建或初始化基础设施。
# 容器访问宿主机使用 host.docker.internal；端口按实际运行值填写。
ENVIRONMENT=development
FRONTEND_PORT=8123
API_PORT=8686
CORS_ORIGINS=["http://localhost:8123","http://127.0.0.1:8123"]

DATABASE_URL=postgresql://postgres:replace-with-local-password@host.docker.internal:5432/lanverse
TEMPORAL_ADDRESS=host.docker.internal:7233
KAFKA_BROKERS=host.docker.internal:19093
KAFKA_USERNAME=
KAFKA_PASSWORD=
ELASTICSEARCH_URL=http://host.docker.internal:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
LOGSTASH_ADDRESS=host.docker.internal:5000

MINIO_ENDPOINT=host.docker.internal:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lanverse-media
MINIO_SECURE=false
MINIO_PUBLIC_SECURE=false

JWT_SECRET_KEY=
# 仅用于本地开发；使用真实 SMTP 时清空固定验证码。
REGISTRATION_VERIFICATION_CODE=123456
SMTP_ENABLED=false
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=

# Agent 统一在 Docker 运行；Creation 使用已准备好 schema 的独立数据库。
# 两个授权密钥必须独立；Harness 只获得自身密钥与 Codex 登录文件。
AGENT_EXECUTION_SECRET=
CREATION_AGENT_SECRET=
CREATION_DATABASE_URL=postgresql://creation:replace-with-local-password@host.docker.internal:5432/lanverse_creation
CREATION_TEXT_RELEASE_HASH=
# 已登录 Codex 的 auth.json 绝对路径，只读挂载，禁止提交登录内容。
LANVERSE_CODEX_AUTH_FILE=
# 仅同一 Creation 服务从本机进程迁入 Docker 时填写原服务地址，保留历史 Run。
CREATION_AGENT_RELOCATED_FROM=

# 可选：本机 chmod 600 的 32-byte 媒体密钥文件路径；Provider API Key 不进入 .env。
LANVERSE_MEDIA_PROVIDER_MASTER_KEY_FILE=
