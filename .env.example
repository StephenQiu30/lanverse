# Lanverse 本机开发环境变量模板
# 复制为 .env 后按本机服务凭据填写；真实 .env 不得提交。

# Go API
ENVIRONMENT=development
API_ADDR=127.0.0.1:8686
FRONTEND_ORIGIN=http://127.0.0.1:8123
DATABASE_URL=postgres://postgres:lanverse-development-only@127.0.0.1:5432/lanverse

# 统一消息队列：backend 的 outbox publisher 与 operation-worker 共用 Kafka。
KAFKA_BROKERS=127.0.0.1:9092

# Redis 只承担会话、短租约锁和 GCRA 限流，不保存业务事实。
REDIS_ADDR=127.0.0.1:6379
REDIS_PASSWORD=

# Elasticsearch 只承担可重建的 approved Narrative 派生索引。
ELASTICSEARCH_URL=http://127.0.0.1:9200
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
ELASTICSEARCH_NARRATIVE_INDEX=lanverse-narrative-approved

# OpenTelemetry 直接发送 Log/Metric/Trace 到 Collector，不经过 Kafka。
OTEL_SERVICE_NAME=lanverse-backend
OTEL_EXPORTER_OTLP_ENDPOINT=http://127.0.0.1:4317

# MinIO 对象存储（复用本机已安装实例；凭据必须与该实例一致）
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=lanverse
MINIO_SECRET_KEY=lanverse-development-only
MINIO_BUCKET=lanverse-media
MINIO_SECURE=false

# Python Agent 仅供 backend 内部调用，不暴露给 frontend 或公共 ingress。
AGENT_URL=http://127.0.0.1:8790
LANVERSE_AGENT_TOKEN=lanverse-agent-local

# Next.js 浏览器请求地址和 Umi OpenAPI 代码生成源。
NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8686
OPENAPI_SCHEMA_URL=../backend/api/openapi.json
