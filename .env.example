# Lanverse 本机开发环境变量模板
# 复制为 .env 后按本机服务填写；真实 .env 不得提交。

ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8686
CORS_ORIGINS=["http://localhost:8123","http://127.0.0.1:8123"]

DATABASE_URL=postgresql://postgres:lanverse-development-only@127.0.0.1:5432/lanverse

MINIO_ENDPOINT=host.docker.internal:9000
MINIO_PUBLIC_ENDPOINT=127.0.0.1:9000
MINIO_PUBLIC_SECURE=false
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=lanverse-media
MINIO_SECURE=false
MINIO_CORS_ORIGINS=http://localhost:8123,http://127.0.0.1:8123
# 留空时不启用图片 Provider，也不读取 RUNWARE_API_KEY。
IMAGE_PROVIDER=
RUNWARE_API_KEY=
RUNWARE_REQUEST_TIMEOUT_SECONDS=30
JWT_SECRET_KEY=development-only-jwt-secret-change-before-production
JWT_ISSUER=lanverse-api
JWT_AUDIENCE=lanverse-web
JWT_ACCESS_TOKEN_MINUTES=30
AUTH_SESSION_TTL_SECONDS=2592000
# 仅限本机开发/隔离 E2E；生产模板留空时关闭自助注册。
REGISTRATION_VERIFICATION_CODE=123456

# Backend 调用本机私有 Agent candidate runtime；Agent 不接收 DATABASE_URL。
AGENT_URL=http://127.0.0.1:8787
AGENT_EXECUTION_SECRET=development-only-agent-execution-secret
AGENT_RUNTIME_IMAGE_DIGEST=sha256:352d46c51661e7d989b42ddeb0a0ff0a4b48165e8e3f7700f3e60d170e4c58cb
# 滚动部署期间为仍有非终态 Invocation 的旧 Bundle 保留精确 URL 与镜像 digest。
AGENT_RUNTIME_ADDITIONAL_REVISIONS=[]
AGENT_POLL_INTERVAL_MS=500
REVIEW_CLAIM_LEASE_SECONDS=300
CODEX_BIN=

# Backend Workflow Runtime 连接已启动的 Temporal；项目容器通过宿主机发布端口复用环境。
TEMPORAL_ADDRESS=127.0.0.1:7233
DOCKER_TEMPORAL_ADDRESS=host.docker.internal:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=lanverse-production-v1

NEXT_PUBLIC_API_BASE_URL=http://127.0.0.1:8686

# Docker Compose 本机运行参数；以下值只用于开发环境。
COMPOSE_PROJECT_NAME=lanverse
LANVERSE_FRONTEND_IMAGE=
LANVERSE_BACKEND_IMAGE=
LANVERSE_CORS_ORIGINS=["http://localhost:8123","http://127.0.0.1:8123"]
FRONTEND_PORT=8123
POSTGRES_DB=lanverse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=lanverse-development-only
POSTGRES_HOST=host.docker.internal
POSTGRES_PORT=5432
KAFKA_PORT=19092
KAFKA_DOCKER_PORT=19093
ELASTICSEARCH_PORT=19200
DOCKER_KAFKA_BROKERS=host.docker.internal:19093
DOCKER_ELASTICSEARCH_URL=http://host.docker.internal:9200
LOGSTASH_ADDRESS=127.0.0.1:5000
DOCKER_LOGSTASH_ADDRESS=host.docker.internal:5000
LOGSTASH_PORT=5000
KAFKA_USERNAME=
KAFKA_PASSWORD=
KAFKA_SECURITY_PROTOCOL=PLAINTEXT
ELASTICSEARCH_USERNAME=lanverse_dev
ELASTICSEARCH_PASSWORD=lanverse-development-elasticsearch
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
TEMPORAL_PORT=7233
TEMPORAL_UI_PORT=8233
