{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanverse.local/schemas/media-delivery-v1.schema.json",
  "title": "Lanverse media and delivery JSONB contracts v1",
  "x-lanverse-invariants": [
    "MEDIA-JSON-001: probe values equal MediaVersion scalar columns and the parent MediaObject selects ImageProbe, VideoProbe or AudioProbe",
    "MEDIA-JSON-002: Subtitle tts_refs and cues are sorted by speech/ordinal with unique IDs; cue ordinals are 1..n, cues do not overlap and stay within their shot, every TTS ref has exactly one cue whose speech_line_id/adoption_id/media_version_id/text_hash/voice_id equal that ref and whose end_ticks-start_ticks equals its duration_ticks, and total text is <= 20000 code points",
    "MEDIA-JSON-003: Render video_refs are unique shot_video refs sorted by ShotSpec ordinal; audio_refs are unique speech_audio refs sorted by cue ordinal",
    "MEDIA-JSON-004: Render segments have ordinals 1..n, unique shot IDs, start_ticks < end_ticks, end-start=duration, are contiguous from zero, correspond one-to-one with video_refs by usage_id/adoption_id/media_version_id/sha256, and sum to 2700000..5400000; each audio placement maps one-to-one to the Subtitle cue and AudioUseRef by speech_line_id=usage_id/adoption_id/media_version_id/sha256, copies cue start/end ticks, and remains inside the owning segment",
    "MEDIA-JSON-005: Delivery artifacts are exactly mp4 video/mp4, srt application/x-subrip and manifest application/json; IDs/hashes/bytes equal the three DeliveryVersion MediaVersion rows"
  ],
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "ImageProbe": {
      "type": "object", "additionalProperties": false, "required": ["codec", "width", "height", "decode_ok"],
      "properties": { "codec": { "type": "string", "minLength": 1, "maxLength": 50 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "decode_ok": { "const": true } }
    },
    "VideoProbe": {
      "type": "object", "additionalProperties": false,
      "required": ["container", "video_codec", "width", "height", "fps_num", "fps_den", "duration_ticks", "timebase", "video_streams", "audio_streams", "decode_ok"],
      "properties": { "container": { "type": "string", "minLength": 1, "maxLength": 50 }, "video_codec": { "type": "string", "minLength": 1, "maxLength": 50 }, "width": { "type": "integer", "minimum": 1 }, "height": { "type": "integer", "minimum": 1 }, "fps_num": { "type": "integer", "minimum": 1 }, "fps_den": { "type": "integer", "minimum": 1 }, "duration_ticks": { "type": "integer", "minimum": 1 }, "timebase": { "type": "integer", "minimum": 1 }, "video_streams": { "type": "integer", "minimum": 1 }, "audio_streams": { "type": "integer", "minimum": 0 }, "decode_ok": { "const": true } }
    },
    "AudioProbe": {
      "type": "object", "additionalProperties": false, "required": ["container", "audio_codec", "sample_rate", "channels", "duration_ticks", "timebase", "decode_ok"],
      "properties": { "container": { "type": "string", "minLength": 1, "maxLength": 50 }, "audio_codec": { "type": "string", "minLength": 1, "maxLength": 50 }, "sample_rate": { "type": "integer", "minimum": 1 }, "channels": { "type": "integer", "minimum": 1 }, "duration_ticks": { "type": "integer", "minimum": 1 }, "timebase": { "type": "integer", "minimum": 1 }, "decode_ok": { "const": true } }
    },
    "MediaProbeSummary": { "oneOf": [{ "$ref": "#/$defs/ImageProbe" }, { "$ref": "#/$defs/VideoProbe" }, { "$ref": "#/$defs/AudioProbe" }] },
    "TtsRef": {
      "type": "object", "additionalProperties": false,
      "required": ["speech_line_id", "adoption_id", "media_version_id", "sha256", "duration_ticks", "voice_id", "text_hash"],
      "properties": { "speech_line_id": { "$ref": "#/$defs/Uuid" }, "adoption_id": { "$ref": "#/$defs/Uuid" }, "media_version_id": { "$ref": "#/$defs/Uuid" }, "sha256": { "$ref": "#/$defs/Hash" }, "duration_ticks": { "type": "integer", "minimum": 1 }, "voice_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "text_hash": { "$ref": "#/$defs/Hash" } }
    },
    "SubtitleInputRefs": {
      "type": "object", "additionalProperties": false, "required": ["script_version_id", "script_hash", "shot_spec_version_id", "shot_spec_hash", "tts_refs"],
      "properties": { "script_version_id": { "$ref": "#/$defs/Uuid" }, "script_hash": { "$ref": "#/$defs/Hash" }, "shot_spec_version_id": { "$ref": "#/$defs/Uuid" }, "shot_spec_hash": { "$ref": "#/$defs/Hash" }, "tts_refs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/TtsRef" } } }
    },
    "SubtitleCue": {
      "type": "object", "additionalProperties": false,
      "required": ["cue_id", "ordinal", "text", "start_ticks", "end_ticks", "shot_id", "speech_line_id", "voice_id", "text_hash", "adoption_id", "media_version_id"],
      "properties": { "cue_id": { "$ref": "#/$defs/Uuid" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 100 }, "text": { "type": "string", "minLength": 1, "maxLength": 500 }, "start_ticks": { "type": "integer", "minimum": 0, "maximum": 5400000 }, "end_ticks": { "type": "integer", "minimum": 1, "maximum": 5400000 }, "shot_id": { "$ref": "#/$defs/Uuid" }, "speech_line_id": { "$ref": "#/$defs/Uuid" }, "voice_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "text_hash": { "$ref": "#/$defs/Hash" }, "adoption_id": { "$ref": "#/$defs/Uuid" }, "media_version_id": { "$ref": "#/$defs/Uuid" } }
    },
    "SubtitleCueList": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/SubtitleCue" } },
    "MediaUseRef": {
      "type": "object", "additionalProperties": false,
      "required": ["usage_type", "usage_id", "adoption_id", "candidate_id", "media_version_id", "sha256", "duration_ticks"],
      "properties": { "usage_type": { "enum": ["shot_video", "speech_audio"] }, "usage_id": { "$ref": "#/$defs/Uuid" }, "adoption_id": { "$ref": "#/$defs/Uuid" }, "candidate_id": { "$ref": "#/$defs/Uuid" }, "media_version_id": { "$ref": "#/$defs/Uuid" }, "sha256": { "$ref": "#/$defs/Hash" }, "duration_ticks": { "type": "integer", "minimum": 1 } }
    },
    "VideoUseRef": { "allOf": [{ "$ref": "#/$defs/MediaUseRef" }, { "properties": { "usage_type": { "const": "shot_video" } } }] },
    "AudioUseRef": { "allOf": [{ "$ref": "#/$defs/MediaUseRef" }, { "properties": { "usage_type": { "const": "speech_audio" } } }] },
    "RenderInputRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_spec_version_id", "shot_spec_hash", "subtitle_version_id", "subtitle_hash", "video_refs", "audio_refs"],
      "properties": { "shot_spec_version_id": { "$ref": "#/$defs/Uuid" }, "shot_spec_hash": { "$ref": "#/$defs/Hash" }, "subtitle_version_id": { "$ref": "#/$defs/Uuid" }, "subtitle_hash": { "$ref": "#/$defs/Hash" }, "video_refs": { "type": "array", "minItems": 6, "maxItems": 10, "items": { "$ref": "#/$defs/VideoUseRef" } }, "audio_refs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/AudioUseRef" } } }
    },
    "AudioPlacement": {
      "type": "object", "additionalProperties": false, "required": ["speech_line_id", "start_ticks", "end_ticks", "adoption_id", "media_version_id", "sha256"],
      "properties": { "speech_line_id": { "$ref": "#/$defs/Uuid" }, "start_ticks": { "type": "integer", "minimum": 0, "maximum": 5400000 }, "end_ticks": { "type": "integer", "minimum": 1, "maximum": 5400000 }, "adoption_id": { "$ref": "#/$defs/Uuid" }, "media_version_id": { "$ref": "#/$defs/Uuid" }, "sha256": { "$ref": "#/$defs/Hash" } }
    },
    "RenderSegment": {
      "type": "object", "additionalProperties": false,
      "required": ["shot_id", "ordinal", "start_ticks", "end_ticks", "duration_ticks", "video_adoption_id", "video_media_version_id", "video_sha256", "audio_placements"],
      "properties": { "shot_id": { "$ref": "#/$defs/Uuid" }, "ordinal": { "type": "integer", "minimum": 1, "maximum": 10 }, "start_ticks": { "type": "integer", "minimum": 0, "maximum": 5400000 }, "end_ticks": { "type": "integer", "minimum": 1, "maximum": 5400000 }, "duration_ticks": { "type": "integer", "minimum": 270000, "maximum": 720000, "multipleOf": 3750 }, "video_adoption_id": { "$ref": "#/$defs/Uuid" }, "video_media_version_id": { "$ref": "#/$defs/Uuid" }, "video_sha256": { "$ref": "#/$defs/Hash" }, "audio_placements": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/AudioPlacement" } } }
    },
    "RenderSegmentList": { "type": "array", "minItems": 6, "maxItems": 10, "items": { "$ref": "#/$defs/RenderSegment" } },
    "RenderNormalization": {
      "type": "object", "additionalProperties": false,
      "required": ["scale_mode", "pad_position", "pad_color", "short_video_policy", "long_video_policy", "strip_source_audio", "tts_speed", "subtitle_mode", "width", "height", "fps", "timebase", "video_codec", "pixel_format", "audio_codec", "audio_rate", "audio_channels", "font_family", "font_sha256", "recipe_version"],
      "properties": { "scale_mode": { "const": "contain" }, "pad_position": { "const": "center" }, "pad_color": { "const": "#000000" }, "short_video_policy": { "const": "freeze_last_frame" }, "long_video_policy": { "const": "trim" }, "strip_source_audio": { "const": true }, "tts_speed": { "const": 1 }, "subtitle_mode": { "const": "burn_in" }, "width": { "const": 720 }, "height": { "const": 1280 }, "fps": { "const": 24 }, "timebase": { "const": 90000 }, "video_codec": { "const": "libx264" }, "pixel_format": { "const": "yuv420p" }, "audio_codec": { "const": "aac" }, "audio_rate": { "const": 48000 }, "audio_channels": { "const": 2 }, "font_family": { "const": "Noto Sans CJK SC" }, "font_sha256": { "$ref": "#/$defs/Hash" }, "recipe_version": { "const": "ffmpeg-recipe-v1" } }
    },
    "ArtifactRef": {
      "type": "object", "additionalProperties": false, "required": ["media_version_id", "byte_size", "sha256", "mime_type"],
      "properties": { "media_version_id": { "$ref": "#/$defs/Uuid" }, "byte_size": { "type": "integer", "minimum": 1 }, "sha256": { "$ref": "#/$defs/Hash" }, "mime_type": { "type": "string", "minLength": 1, "maxLength": 100 } }
    },
    "DeliveryArtifactSummary": {
      "type": "object", "additionalProperties": false, "required": ["mp4", "srt", "manifest"],
      "properties": { "mp4": { "$ref": "#/$defs/ArtifactRef" }, "srt": { "$ref": "#/$defs/ArtifactRef" }, "manifest": { "$ref": "#/$defs/ArtifactRef" } }
    },
    "DeliveryProbeSummary": {
      "type": "object", "additionalProperties": false,
      "required": ["container", "video_codec", "pixel_format", "audio_codec", "width", "height", "fps_num", "fps_den", "audio_rate", "audio_channels", "duration_ticks", "timebase", "video_streams", "audio_streams", "decode_ok", "av_delta_ms"],
      "properties": { "container": { "const": "mp4" }, "video_codec": { "const": "h264" }, "pixel_format": { "const": "yuv420p" }, "audio_codec": { "const": "aac" }, "width": { "const": 720 }, "height": { "const": 1280 }, "fps_num": { "const": 24 }, "fps_den": { "const": 1 }, "audio_rate": { "const": 48000 }, "audio_channels": { "const": 2 }, "duration_ticks": { "type": "integer", "minimum": 2700000, "maximum": 5400000 }, "timebase": { "const": 90000 }, "video_streams": { "const": 1 }, "audio_streams": { "const": 1 }, "decode_ok": { "const": true }, "av_delta_ms": { "type": "integer", "minimum": -100, "maximum": 100 } }
    }
  }
}
