{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://lanverse.local/schemas/production-jobs-v1.schema.json",
  "title": "Lanverse production jobs JSONB contracts v1",
  "x-lanverse-invariants": [
    "JOBS-JSON-001: row type selects exactly one input/parameter/scope variant and their values agree: generate_script uses capability text, source.resource_type source_revision and scope.source_revision_id=source.resource_id; generate_storyboard uses capability text, script.resource_type script_version and scope.script_version_id=script.resource_id; generate_media copies usage_type/usage_id/input_version_id/input_hash exactly into TaskMediaScope, maps asset_image and shot_image to image, shot_video to video and speech_audio to tts, and uses version_refs exact-set asset_image=target creative_asset_version, shot_image/shot_video=target shot_spec_version plus every related creative_asset_version, speech_audio=target script_version while dependency_adoptions are empty for asset_image/speech_audio, related asset_image refs for shot_image, and related asset_image plus shot_image refs for shot_video; render_episode has null capability, empty RenderParameters, render_snapshot.resource_type render_snapshot and scope.render_snapshot_id=render_snapshot.resource_id",
    "JOBS-JSON-002: schema defaults are accepted at command validation only; persisted JSON is the full required model_dump with defaults and nulls materialized",
    "JOBS-JSON-003: TaskProgress completed <= total",
    "JOBS-JSON-004: VersionRef and AdoptionRef arrays are sorted by resource_type/usage_type then UUID bytes and contain no duplicate logical reference",
    "JOBS-JSON-005: event mapping is task.accepted=Empty, task.started=AttemptCreated, task.progressed=Progress, task.cancel_requested=Empty, task.cancelled=Empty, task.succeeded=Empty, task.failed=Failure, task.unknown=Unknown, task.reconciled=Reconciled, attempt.created=AttemptCreated, attempt.updated=AttemptUpdated, output.recorded=OutputRecorded"
  ],
  "$defs": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Hash": { "type": "string", "pattern": "^[0-9a-f]{64}$" },
    "NullableUuid": { "oneOf": [{ "$ref": "#/$defs/Uuid" }, { "type": "null" }] },
    "NullableText": { "type": ["string", "null"], "maxLength": 500 },
    "IdempotencyResponseRef": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_type", "resource_id", "episode_id", "task_id", "delivery_id"],
      "properties": {
        "resource_type": { "enum": ["project", "source_revision", "script_version", "creative_asset_version", "shot_spec_version", "subtitle_version", "production_task", "render_snapshot", "adoption", "media_version", "delivery_version"] },
        "resource_id": { "$ref": "#/$defs/Uuid" },
        "episode_id": { "$ref": "#/$defs/NullableUuid" },
        "task_id": { "$ref": "#/$defs/NullableUuid" },
        "delivery_id": { "$ref": "#/$defs/NullableUuid" }
      }
    },
    "VersionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["resource_type", "resource_id", "content_hash"],
      "properties": {
        "resource_type": { "enum": ["source_revision", "script_version", "creative_asset_version", "shot_spec_version", "subtitle_version", "render_snapshot"] },
        "resource_id": { "$ref": "#/$defs/Uuid" },
        "content_hash": { "$ref": "#/$defs/Hash" }
      }
    },
    "AdoptionRef": {
      "type": "object", "additionalProperties": false,
      "required": ["usage_type", "usage_id", "adoption_id", "candidate_id", "media_version_id", "sha256"],
      "properties": {
        "usage_type": { "enum": ["asset_image", "shot_image", "shot_video", "speech_audio"] },
        "usage_id": { "$ref": "#/$defs/Uuid" },
        "adoption_id": { "$ref": "#/$defs/Uuid" },
        "candidate_id": { "$ref": "#/$defs/Uuid" },
        "media_version_id": { "$ref": "#/$defs/Uuid" },
        "sha256": { "$ref": "#/$defs/Hash" }
      }
    },
    "SubmissionScriptInputRefs": { "type": "object", "additionalProperties": false, "required": ["source"], "properties": { "source": { "$ref": "#/$defs/VersionRef" } } },
    "SubmissionStoryboardInputRefs": { "type": "object", "additionalProperties": false, "required": ["script"], "properties": { "script": { "$ref": "#/$defs/VersionRef" } } },
    "SubmissionMediaInputRefs": {
      "type": "object", "additionalProperties": false,
      "required": ["usage_type", "usage_id", "input_version_id", "input_hash", "version_refs", "dependency_adoptions"],
      "properties": {
        "usage_type": { "enum": ["asset_image", "shot_image", "shot_video", "speech_audio"] },
        "usage_id": { "$ref": "#/$defs/Uuid" },
        "input_version_id": { "$ref": "#/$defs/Uuid" },
        "input_hash": { "$ref": "#/$defs/Hash" },
        "version_refs": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/VersionRef" } },
        "dependency_adoptions": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/AdoptionRef" } }
      }
    },
    "SubmissionRenderInputRefs": { "type": "object", "additionalProperties": false, "required": ["render_snapshot"], "properties": { "render_snapshot": { "$ref": "#/$defs/VersionRef" } } },
    "SubmissionInputRefs": { "oneOf": [{ "$ref": "#/$defs/SubmissionScriptInputRefs" }, { "$ref": "#/$defs/SubmissionStoryboardInputRefs" }, { "$ref": "#/$defs/SubmissionMediaInputRefs" }, { "$ref": "#/$defs/SubmissionRenderInputRefs" }] },
    "TextParameters": {
      "type": "object", "additionalProperties": false, "required": ["temperature", "max_output_tokens", "seed"],
      "properties": { "temperature": { "type": "number", "minimum": 0, "maximum": 2, "default": 0 }, "max_output_tokens": { "type": "integer", "minimum": 1, "maximum": 32768, "default": 4096 }, "seed": { "type": ["integer", "null"], "default": 0 } }
    },
    "ImageParameters": {
      "type": "object", "additionalProperties": false, "required": ["width", "height", "steps", "guidance", "seed"],
      "properties": { "width": { "type": "integer", "minimum": 256, "maximum": 2048, "default": 720 }, "height": { "type": "integer", "minimum": 256, "maximum": 2048, "default": 1280 }, "steps": { "type": "integer", "minimum": 1, "maximum": 100, "default": 30 }, "guidance": { "type": "number", "minimum": 0, "maximum": 30, "default": 7 }, "seed": { "type": ["integer", "null"], "default": 0 } }
    },
    "VideoParameters": {
      "type": "object", "additionalProperties": false, "required": ["width", "height", "fps", "duration_ticks", "seed"],
      "properties": { "width": { "type": "integer", "minimum": 256, "maximum": 2048, "default": 720 }, "height": { "type": "integer", "minimum": 256, "maximum": 2048, "default": 1280 }, "fps": { "const": 24 }, "duration_ticks": { "type": "integer", "minimum": 270000, "maximum": 720000, "multipleOf": 3750 }, "seed": { "type": ["integer", "null"], "default": 0 } }
    },
    "TtsParameters": {
      "type": "object", "additionalProperties": false, "required": ["voice_id", "sample_rate", "output_format", "speed"],
      "properties": { "voice_id": { "type": "string", "minLength": 1, "maxLength": 128 }, "sample_rate": { "const": 48000 }, "output_format": { "enum": ["wav", "mp3"] }, "speed": { "const": 1 } }
    },
    "RenderParameters": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "SubmissionParameters": { "oneOf": [{ "$ref": "#/$defs/TextParameters" }, { "$ref": "#/$defs/ImageParameters" }, { "$ref": "#/$defs/VideoParameters" }, { "$ref": "#/$defs/TtsParameters" }, { "$ref": "#/$defs/RenderParameters" }] },
    "TaskScriptScope": { "type": "object", "additionalProperties": false, "required": ["source_revision_id"], "properties": { "source_revision_id": { "$ref": "#/$defs/Uuid" } } },
    "TaskStoryboardScope": { "type": "object", "additionalProperties": false, "required": ["script_version_id"], "properties": { "script_version_id": { "$ref": "#/$defs/Uuid" } } },
    "TaskMediaScope": { "type": "object", "additionalProperties": false, "required": ["usage_type", "usage_id", "input_version_id", "input_hash"], "properties": { "usage_type": { "enum": ["asset_image", "shot_image", "shot_video", "speech_audio"] }, "usage_id": { "$ref": "#/$defs/Uuid" }, "input_version_id": { "$ref": "#/$defs/Uuid" }, "input_hash": { "$ref": "#/$defs/Hash" } } },
    "TaskRenderScope": { "type": "object", "additionalProperties": false, "required": ["render_snapshot_id"], "properties": { "render_snapshot_id": { "$ref": "#/$defs/Uuid" } } },
    "TaskScope": { "oneOf": [{ "$ref": "#/$defs/TaskScriptScope" }, { "$ref": "#/$defs/TaskStoryboardScope" }, { "$ref": "#/$defs/TaskMediaScope" }, { "$ref": "#/$defs/TaskRenderScope" }] },
    "TaskProgress": {
      "type": "object", "additionalProperties": false, "required": ["phase", "completed", "total", "safe_message"],
      "properties": { "phase": { "enum": ["accepted", "queued", "submitting", "provider_wait", "downloading", "postprocessing", "reconciling", "completed"] }, "completed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 }, "safe_message": { "$ref": "#/$defs/NullableText" } }
    },
    "TaskError": {
      "type": "object", "additionalProperties": false, "required": ["retryable", "safe_detail", "provider_code", "failed_field"],
      "properties": { "retryable": { "type": "boolean" }, "safe_detail": { "type": "string", "minLength": 1, "maxLength": 500 }, "provider_code": { "$ref": "#/$defs/NullableText" }, "failed_field": { "$ref": "#/$defs/NullableText" } }
    },
    "AttemptUsage": {
      "type": "object", "additionalProperties": false, "required": ["input_tokens", "output_tokens", "images", "video_ticks", "tts_codepoints", "cost_microunits", "currency"],
      "properties": { "input_tokens": { "type": "integer", "minimum": 0, "default": 0 }, "output_tokens": { "type": "integer", "minimum": 0, "default": 0 }, "images": { "type": "integer", "minimum": 0, "default": 0 }, "video_ticks": { "type": "integer", "minimum": 0, "default": 0 }, "tts_codepoints": { "type": "integer", "minimum": 0, "default": 0 }, "cost_microunits": { "type": "integer", "minimum": 0, "default": 0 }, "currency": { "type": ["string", "null"], "pattern": "^[A-Z]{3}$", "default": null } }
    },
    "AttemptSafety": {
      "type": "object", "additionalProperties": false, "required": ["decision", "categories", "policy_id", "evidence_hash"],
      "properties": { "decision": { "enum": ["not_evaluated", "allowed", "blocked", "review"] }, "categories": { "type": "array", "maxItems": 50, "uniqueItems": true, "items": { "type": "string", "minLength": 1, "maxLength": 100 } }, "policy_id": { "$ref": "#/$defs/NullableText" }, "evidence_hash": { "oneOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] } }
    },
    "AttemptExecution": {
      "type": "object", "additionalProperties": false, "required": ["adapter_id", "tool_name", "tool_version", "release_version", "request_evidence_hash", "args_hash"],
      "properties": { "adapter_id": { "$ref": "#/$defs/NullableText" }, "tool_name": { "$ref": "#/$defs/NullableText" }, "tool_version": { "$ref": "#/$defs/NullableText" }, "release_version": { "$ref": "#/$defs/NullableText" }, "request_evidence_hash": { "oneOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] }, "args_hash": { "oneOf": [{ "$ref": "#/$defs/Hash" }, { "type": "null" }] } }
    },
    "EmptyEventData": { "type": "object", "additionalProperties": false, "maxProperties": 0 },
    "ProgressEventData": { "type": "object", "additionalProperties": false, "required": ["phase", "completed", "total"], "properties": { "phase": { "type": "string", "minLength": 1, "maxLength": 100 }, "completed": { "type": "integer", "minimum": 0 }, "total": { "type": "integer", "minimum": 1 } } },
    "AttemptCreatedEventData": { "type": "object", "additionalProperties": false, "required": ["attempt_id", "attempt_no"], "properties": { "attempt_id": { "$ref": "#/$defs/Uuid" }, "attempt_no": { "type": "integer", "minimum": 1, "maximum": 3 } } },
    "AttemptUpdatedEventData": { "type": "object", "additionalProperties": false, "required": ["attempt_id", "status"], "properties": { "attempt_id": { "$ref": "#/$defs/Uuid" }, "status": { "enum": ["created", "submitted", "provider_running", "downloading", "postprocessing", "succeeded", "failed", "cancelled", "unknown"] } } },
    "FailureEventData": { "type": "object", "additionalProperties": false, "required": ["error_code", "retryable"], "properties": { "error_code": { "type": "string", "minLength": 1, "maxLength": 100 }, "retryable": { "type": "boolean" } } },
    "UnknownEventData": { "type": "object", "additionalProperties": false, "required": ["error_code", "next_action"], "properties": { "error_code": { "type": "string", "minLength": 1, "maxLength": 100 }, "next_action": { "type": "string", "minLength": 1, "maxLength": 200 } } },
    "ReconciledEventData": { "type": "object", "additionalProperties": false, "required": ["from_status", "to_status"], "properties": { "from_status": { "type": "string", "minLength": 1, "maxLength": 50 }, "to_status": { "type": "string", "minLength": 1, "maxLength": 50 } } },
    "OutputRecordedEventData": { "type": "object", "additionalProperties": false, "required": ["output_type", "output_id", "ordinal"], "properties": { "output_type": { "enum": ["script_version", "creative_asset_version", "shot_spec_version", "generation_candidate", "delivery_version"] }, "output_id": { "$ref": "#/$defs/Uuid" }, "ordinal": { "type": "integer", "minimum": 0 } } },
    "TaskEventData": { "oneOf": [{ "$ref": "#/$defs/EmptyEventData" }, { "$ref": "#/$defs/ProgressEventData" }, { "$ref": "#/$defs/AttemptCreatedEventData" }, { "$ref": "#/$defs/AttemptUpdatedEventData" }, { "$ref": "#/$defs/FailureEventData" }, { "$ref": "#/$defs/UnknownEventData" }, { "$ref": "#/$defs/ReconciledEventData" }, { "$ref": "#/$defs/OutputRecordedEventData" }] },
    "TaskJobPayload": {
      "type": "object", "additionalProperties": false, "required": ["task_id", "snapshot_id", "release_version"],
      "properties": { "task_id": { "$ref": "#/$defs/Uuid" }, "snapshot_id": { "$ref": "#/$defs/Uuid" }, "release_version": { "type": "string", "minLength": 1, "maxLength": 100 } }
    }
  }
}
