# 镜像部署配置：公共连接字段沿用 .env.example，按实际运行环境填写。
# docker compose --env-file .env.production -f docker-compose.yml -f deploy/compose.production.yml up -d
# 不创建基础设施；Agent 镜像仍由当前 Compose 构建，完整镜像制品部署另行验收。
ENVIRONMENT=production
LANVERSE_FRONTEND_IMAGE=
LANVERSE_BACKEND_IMAGE=
DATABASE_URL=
TEMPORAL_ADDRESS=
KAFKA_BROKERS=
KAFKA_USERNAME=
KAFKA_PASSWORD=
ELASTICSEARCH_URL=
ELASTICSEARCH_USERNAME=
ELASTICSEARCH_PASSWORD=
LOGSTASH_ADDRESS=
MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true
MINIO_PUBLIC_SECURE=true
CORS_ORIGINS=["https://app.example.com"]
JWT_SECRET_KEY=
AGENT_EXECUTION_SECRET=
CREATION_DATABASE_URL=
CREATION_AGENT_SECRET=
CREATION_TEXT_RELEASE_HASH=
LANVERSE_CODEX_AUTH_FILE=
LANVERSE_MEDIA_PROVIDER_MASTER_KEY_FILE=
REGISTRATION_VERIFICATION_CODE=
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
