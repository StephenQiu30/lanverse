# Lanverse 生产环境变量模板；真实 secret 由部署平台注入，不提交本文件的副本。
# 未列出的配置使用代码默认值。

# API 监听地址：生产环境通常绑定到所有网卡；前端地址用于 CORS 校验。
ENVIRONMENT=production
API_ADDR=0.0.0.0:8686
FRONTEND_ORIGIN=https://app.example.com

# API 必需依赖：请替换为空值；未配置时部分组件会回退到本机默认地址。
DATABASE_URL=
AUTH_JWT_SECRET=
# 生产环境必须启用 Secure Cookie，避免 refresh token 通过明文 HTTP 传输。
AUTH_COOKIE_SECURE=true
REDIS_ADDR=
MINIO_ENDPOINT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_SECURE=true

# 仅 operation-worker 运行角色需要；API 角色无需配置这三项。
KAFKA_BROKERS=
AGENT_URL=
LANVERSE_AGENT_TOKEN=
