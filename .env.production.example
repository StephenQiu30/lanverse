# Lanverse production 环境变量模板
# 使用方式：复制为 `.env.production`，填写全部必需 secret、域名和镜像地址，且不得提交真实文件。
# 字段必须与 `.env.example` 保持一致；只允许默认值和安全策略存在环境差异。
# 所有 `NEXT_PUBLIC_*` 都会进入浏览器包，禁止放入密钥。

# -----------------------------------------------------------------------------
# 应用与 API（FastAPI Settings；Compose 只覆盖容器内部监听地址）
# -----------------------------------------------------------------------------
APP_NAME=Lanverse API
ENVIRONMENT=production
LOG_LEVEL=INFO
API_HOST=0.0.0.0
API_PORT=8686
CORS_ORIGINS=["https://app.example.com"]

# -----------------------------------------------------------------------------
# 数据库与消息基础设施
# -----------------------------------------------------------------------------
# 非 Compose 进程直接运行时填写完整连接串；连接串包含凭据，因此模板必须留空。
# Compose 会使用下方 POSTGRES_* / RABBITMQ_DEFAULT_* 在容器内构造连接串。
DATABASE_URL=
# 仅独立生产验收需要，必须使用隔离测试库且数据库名以 _test 结尾。
TEST_DATABASE_URL=
REDIS_URL=redis://redis:6379/0
WORKSPACE_CACHE_TTL_SECONDS=60
CACHE_TTL_JITTER_SECONDS=10
GENERATION_HIGH_COST_WINDOW_SECONDS=60
GENERATION_HIGH_COST_WORKSPACE_LIMIT=3
GENERATION_HIGH_COST_GLOBAL_LIMIT=20
GENERATION_HIGH_COST_IDEMPOTENCY_TTL_SECONDS=900
RABBITMQ_URL=
OUTBOX_BATCH_SIZE=20
OUTBOX_CLAIM_SECONDS=60
OUTBOX_POLL_SECONDS=1.0

# -----------------------------------------------------------------------------
# MinIO 对象存储
# -----------------------------------------------------------------------------
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lanverse-media
MINIO_SECURE=false
INFRASTRUCTURE_TIMEOUT_SECONDS=1.5
STORAGE_THREAD_LIMIT=4
STORAGE_OPERATION_TIMEOUT_SECONDS=3

# -----------------------------------------------------------------------------
# 媒体处理限制
# -----------------------------------------------------------------------------
MEDIA_MAX_UPLOAD_BYTES=2147483648
SCRIPT_DOCUMENT_MAX_BYTES=400000
SCRIPT_DOCUMENT_MAX_CODEPOINTS=100000
MEDIA_UPLOAD_TTL_SECONDS=900
MEDIA_ACCESS_TTL_SECONDS=300
MEDIA_PROBE_TIMEOUT_SECONDS=120
MEDIA_CLEANUP_INTERVAL_SECONDS=3600
MEDIA_CLEANUP_BATCH_SIZE=100
# 位置迁移后保留旧对象的回滚窗口秒数，允许 60-604800（7 天）。
MEDIA_LOCATION_ROLLBACK_SECONDS=86400

# -----------------------------------------------------------------------------
# API 身份认证
# -----------------------------------------------------------------------------
JWT_SECRET_KEY=
JWT_ISSUER=lanverse-api
JWT_AUDIENCE=lanverse-web
JWT_ACCESS_TOKEN_MINUTES=30

# -----------------------------------------------------------------------------
# 注册邮箱验证（全部 secret 由部署环境注入）
# -----------------------------------------------------------------------------
SMTP_ENABLED=true
SMTP_HOST=
SMTP_PORT=465
SMTP_TLS_MODE=tls
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Lanverse
SMTP_TIMEOUT_SECONDS=10
EMAIL_VERIFICATION_HMAC_SECRET=
EMAIL_VERIFICATION_TTL_SECONDS=600
EMAIL_VERIFICATION_RESEND_SECONDS=60
EMAIL_VERIFICATION_MAX_ATTEMPTS=5
EMAIL_VERIFICATION_TICKET_TTL_SECONDS=600
EMAIL_VERIFICATION_SOURCE_WINDOW_SECONDS=3600
EMAIL_VERIFICATION_SOURCE_LIMIT=20

# -----------------------------------------------------------------------------
# AI Provider（未启用真实能力时保持为空）
# -----------------------------------------------------------------------------
DEEPSEEK_API_KEY=
ARK_API_KEY=
PROVIDER_CREDENTIAL_KEY_ID=local-provider-v1
# 两项均由部署 Secret/KMS 注入独立 32-byte 随机值的 URL-safe Base64。
PROVIDER_CREDENTIAL_MASTER_KEY=
PROVIDER_CREDENTIAL_FINGERPRINT_KEY=

# -----------------------------------------------------------------------------
# 前端与代码生成
# -----------------------------------------------------------------------------
NEXT_PUBLIC_API_BASE_URL=https://api.example.com
OPENAPI_SCHEMA_URL=https://api.example.com/openapi.json

# -----------------------------------------------------------------------------
# Docker Compose production 部署
# -----------------------------------------------------------------------------
BACKEND_IMAGE=registry.example.com/lanverse/backend:latest
FRONTEND_IMAGE=registry.example.com/lanverse/frontend:latest
WEB_PORT=8123
# 生产覆盖层不会把以下四项基础设施端口发布到宿主机；保留字段以统一环境契约。
POSTGRES_PORT=5432
REDIS_PORT=6379
RABBITMQ_PORT=5672
MINIO_API_PORT=9000
MINIO_CONSOLE_PORT=9001
# PostgreSQL 初始化配置；密码必须由部署环境注入。
POSTGRES_DB=lanverse
POSTGRES_USER=lanverse
POSTGRES_PASSWORD=
# RabbitMQ 初始化配置；密码必须由部署环境注入。
RABBITMQ_DEFAULT_USER=lanverse
RABBITMQ_DEFAULT_PASS=
