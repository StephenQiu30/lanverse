# Lanverse 生产环境变量模板
# 真实 secret 由运行环境注入；本文件只描述当前服务运行契约。

ENVIRONMENT=production
API_HOST=0.0.0.0
API_PORT=8686
CORS_ORIGINS=["https://app.example.com"]

DATABASE_URL=

MINIO_ENDPOINT=
MINIO_PUBLIC_ENDPOINT=
MINIO_PUBLIC_SECURE=true
MINIO_REGION=us-east-1
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=lanverse-media
MINIO_SECURE=true
MINIO_CORS_ORIGINS=https://app.example.com
JWT_SECRET_KEY=
JWT_ISSUER=lanverse-api
JWT_AUDIENCE=lanverse-web
JWT_ACCESS_TOKEN_MINUTES=30
AUTH_SESSION_TTL_SECONDS=2592000
REGISTRATION_VERIFICATION_CODE=

AGENT_URL=
AGENT_EXECUTION_SECRET=
AGENT_RUNTIME_IMAGE_DIGEST=
AGENT_RUNTIME_ADDITIONAL_REVISIONS=[]
AGENT_POLL_INTERVAL_MS=500
REVIEW_CLAIM_LEASE_SECONDS=300
CODEX_BIN=

NEXT_PUBLIC_API_BASE_URL=https://api.example.com

# Docker Compose 生产部署参数；镜像必须由已验证的制品仓库提供。
COMPOSE_PROJECT_NAME=lanverse
LANVERSE_FRONTEND_IMAGE=
LANVERSE_BACKEND_IMAGE=
LANVERSE_CORS_ORIGINS=["https://app.example.com"]
FRONTEND_PORT=8123
# 必填 chmod 600 的 32-byte root-key 文件路径；Provider API Key 不进入环境变量。
# Backend 启动器只把它复制到容器 tmpfs 的 0400/lanverse 固定路径，随后立即降权运行。
# Web 写入入口将在 SG-I22 交付；当前仅有 Backend 领域服务与持久化合同。
LANVERSE_MEDIA_PROVIDER_MASTER_KEY_FILE=
POSTGRES_DB=lanverse
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_PORT=5432
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
