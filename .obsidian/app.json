{
  "newFileLocation": "folder",
  "newFileFolderPath": "workspace/content",
  "useMarkdownLinks": true,
  "newLinkFormat": "relative",
  "alwaysUpdateLinks": true,
  "userIgnoreFilters": [
    "backend/",
    "frontend/",
    "workspace/app/",
    "workspace/components/",
    "workspace/lib/",
    "workspace/tests/",
    "workspace/node_modules/",
