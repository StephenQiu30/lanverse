{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.lanverse.local/event/event-envelope-v2.schema.json",
  "title": "Event Envelope v2",
  "description": "Kafka 业务事件的严格公共包络；v1 IO/Media 消息不得使用本契约。",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "envelope_version",
    "event_id",
    "event_type",
    "schema_version",
    "aggregate_type",
    "aggregate_id",
    "aggregate_version",
    "workspace_id",
    "partition_key",
    "occurred_at",
    "traceparent",
    "correlation_id",
    "payload"
  ],
  "properties": {
    "envelope_version": {
      "const": 2
    },
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "event_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100,
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+\\.v[1-9][0-9]*$"
    },
    "schema_version": {
      "type": "integer",
      "minimum": 1
    },
    "aggregate_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 100
    },
    "aggregate_id": {
      "type": "string",
      "format": "uuid"
    },
    "aggregate_version": {
      "type": "integer",
      "minimum": 1
    },
    "workspace_id": {
      "type": "string",
      "format": "uuid"
    },
    "partition_key": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "traceparent": {
      "type": "string",
      "pattern": "^00-[0-9a-f]{32}-[0-9a-f]{16}-[0-9a-f]{2}$"
    },
    "correlation_id": {
      "type": "string",
      "format": "uuid"
    },
    "causation_id": {
      "type": ["string", "null"],
      "format": "uuid"
    },
    "payload": {
      "type": "object"
    }
  }
}
