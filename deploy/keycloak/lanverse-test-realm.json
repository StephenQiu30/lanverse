{
  "realm": "lanverse-test",
  "displayName": "Lanverse Test",
  "enabled": true,
  "sslRequired": "external",
  "registrationAllowed": false,
  "resetPasswordAllowed": true,
  "loginWithEmailAllowed": true,
  "clients": [
    {
      "clientId": "lanverse-api",
      "name": "Lanverse API",
      "protocol": "openid-connect",
      "bearerOnly": true,
      "enabled": true
    },
    {
      "clientId": "lanverse-web",
      "name": "Lanverse Web",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": true,
      "directAccessGrantsEnabled": false,
      "redirectUris": [
        "http://127.0.0.1:3000/*",
        "http://localhost:3000/*"
      ],
      "webOrigins": [
        "http://127.0.0.1:3000",
        "http://localhost:3000"
      ],
      "attributes": {
        "pkce.code.challenge.method": "S256"
      },
      "protocolMappers": [
        {
          "name": "lanverse-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lanverse-api",
            "access.token.claim": "true"
          }
        }
      ]
    },
    {
      "clientId": "lanverse-contract",
      "name": "Lanverse OIDC Contract",
      "protocol": "openid-connect",
      "publicClient": true,
      "standardFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "serviceAccountsEnabled": false,
      "protocolMappers": [
        {
          "name": "lanverse-api-audience",
          "protocol": "openid-connect",
          "protocolMapper": "oidc-audience-mapper",
          "consentRequired": false,
          "config": {
            "included.client.audience": "lanverse-api",
            "access.token.claim": "true"
          }
        }
      ]
    }
  ]
}
