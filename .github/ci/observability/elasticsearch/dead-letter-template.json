{
  "index_patterns": [
    "lanverse-logs-dead-letter-*"
  ],
  "priority": 200,
  "template": {
    "settings": {
      "index.lifecycle.name": "lanverse-logs-application-30d",
      "index.lifecycle.rollover_alias": "lanverse-logs-dead-letter",
      "number_of_shards": 1,
      "number_of_replicas": 0,
      "refresh_interval": "1s"
    },
    "mappings": {
      "dynamic": "strict",
      "properties": {
        "@timestamp": {
          "type": "date"
        },
        "schema_version": {
          "type": "keyword"
        },
        "error_code": {
          "type": "keyword"
        },
        "raw_sha256": {
          "type": "keyword"
        },
        "tags": {
          "type": "keyword"
        }
      }
    }
  }
}
